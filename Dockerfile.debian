# Debian-based image providing the `cvisor` CLI and the `cvisord` daemon, with
# runtime toolchains for sandboxed workloads (mise, uv/python, elixir, gleam).
#
# Build:  docker build -f Dockerfile.debian -t cvisor:debian .
# Run the daemon (gRPC :50051, GraphQL :8080):
#   docker run --rm --security-opt seccomp=unconfined \
#     -p 50051:50051 -p 8080:8080 -e CVISOR_TOKEN=change-me \
#     --entrypoint cvisord cvisor:debian
#
# cVisor installs its own seccomp filter, so run with the default seccomp
# profile disabled (--security-opt seccomp=unconfined).

# Build the web UI first (the CLI embeds ui/dist via rust-embed). Dependencies
# install in their own layer so editing ui/src doesn't re-run bun install.
FROM oven/bun:alpine AS web
WORKDIR /src/ui
COPY ui/package.json ui/bun.lock ./
RUN bun install
COPY ui/ .
RUN bun run build

# perl builds ring's C (s3 TLS); protobuf-compiler gives build.rs a protoc
# (a glibc host, so the vendored one would also work — this is just explicit).
FROM rust:bookworm AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
      perl pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked
WORKDIR /src

# The recipe is a manifest-only digest of the workspace: it changes when
# dependencies change, not when sources do.
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
# Compile every dependency against stub sources; this layer is reused across
# source-only changes. Feature flags must match the real build below or the
# cached artifacts don't apply.
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release -p cvisor-cli --features zstd,s3 --recipe-path recipe.json \
 && cargo chef cook --release -p cvisor-daemon --features zstd,s3 --recipe-path recipe.json
COPY . .
# Overlay the built web assets so the embedded UI isn't the placeholder.
COPY --from=web /src/ui/dist ui/dist
# Native glibc build (all optional features: zstd + s3). No musl linker override.
RUN cargo build -p cvisor-cli --bin cvisor --release --features zstd,s3
RUN cargo build -p cvisor-daemon --bin cvisord --release --features zstd,s3

FROM debian:trixie-slim
# Tools available to sandboxed commands. elixir pulls erlang (which gleam needs).
# The binary is built on bookworm (older glibc), which runs on trixie's newer one.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash curl git ca-certificates tmux \
      python3 python3-pip python3-venv \
      elixir \
    && rm -rf /var/lib/apt/lists/*
# bun (+bunx) and deno from their official images (glibc builds).
COPY --from=oven/bun:latest /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s bun /usr/local/bin/bunx
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno
# mise (version manager) via its installer.
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh
# uv (+uvx) and gleam aren't in the base repos; copy their static binaries.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
COPY --from=ghcr.io/gleam-lang/gleam:v1.15.0-erlang-alpine /bin/gleam /usr/local/bin/gleam
# AI coding agents: claude, codex, gemini, opencode, amp, kilo ship as npm CLIs.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm unzip \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --no-fund --no-audit \
      @anthropic-ai/claude-code \
      @openai/codex \
      @google/gemini-cli \
      opencode-ai \
      @sourcegraph/amp \
      @kilocode/cli \
    && npm cache clean --force
# Kiro CLI is not on npm; install its release binaries from the official zip.
RUN curl -fsSL "https://prod.download.cli.kiro.dev/stable/latest/kirocli-$(uname -m)-linux.zip" \
      -o /tmp/kirocli.zip \
    && unzip -q /tmp/kirocli.zip -d /tmp \
    && install -m755 /tmp/kirocli/bin/kiro-cli /tmp/kirocli/bin/kiro-cli-chat \
      /tmp/kirocli/bin/kiro-cli-term /usr/local/bin/ \
    && rm -rf /tmp/kirocli /tmp/kirocli.zip
COPY --from=build /src/target/release/cvisor /usr/local/bin/cvisor
COPY --from=build /src/target/release/cvisord /usr/local/bin/cvisord
# gRPC and GraphQL, respectively (the daemon binds 0.0.0.0 by default).
EXPOSE 50051 8080
ENTRYPOINT ["cvisor"]
