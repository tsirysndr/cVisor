{:paths ["src" "resources"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.1"}
         org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:test    {:extra-paths ["test"]
            :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
            :main-opts   ["-m" "cvisor.sandbox-test"]}
  :remote  {:extra-paths ["test"]
            :main-opts   ["-m" "cvisor.remote-smoke"]}
  :console {:extra-paths ["dev"]
            :extra-deps  {com.bhauman/rebel-readline {:mvn/version "0.1.5"}}
            :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
            :main-opts   ["-m" "cvisor.console"]}
  :build   {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                         slipset/deps-deploy            {:mvn/version "0.2.2"}}
            :ns-default build}}}
