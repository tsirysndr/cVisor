{
  "name": "cvisor",
  "version": "0.2.0",
  "description": "In-process Linux sandbox for Node, Bun, and Deno (napi + FFI over libcvisor)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsirysndr/cVisor.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/tsirysndr/cVisor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": {
        "types": "./dist/src/bun.d.ts",
        "default": "./dist/src/bun.js"
      },
      "deno": {
        "types": "./dist/src/deno.d.ts",
        "default": "./dist/src/deno.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/src/bun.d.ts",
      "default": "./dist/src/bun.js"
    },
    "./deno": {
      "types": "./dist/src/deno.d.ts",
      "default": "./dist/src/deno.js"
    }
  },
  "files": [
    "dist/",
    "index.ts",
    "src/"
  ],
  "scripts": {
    "build": "tsc",
    "build:native": "cd ../../.. && cargo xtask node-artifacts",
    "prepublishOnly": "npm run build",
    "version:patch": "npm version patch --workspaces --no-git-tag-version --force && npm version patch --no-git-tag-version --force",
    "publish:all": "npm run build:native && bun scripts/publish.ts"
  },
  "workspaces": [
    "platforms/*"
  ],
  "dependencies": {
    "detect-libc": "^2.0.3"
  },
  "optionalDependencies": {
    "@cvisor/linux-arm64-gnu": "workspace:*",
    "@cvisor/linux-arm64-musl": "workspace:*",
    "@cvisor/linux-x64-gnu": "workspace:*",
    "@cvisor/linux-x64-musl": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.2.0",
    "typescript": "^5.0.0"
  }
}
