{:paths ["src"]

 :deps
 {babashka/process {:mvn/version "0.5.22"}
  babashka/fs      {:mvn/version "0.5.22"}}

 :aliases
 {;; nREPL for editor connection: `clj -M:dev`
  :dev
  {:extra-paths ["dev"]
   :extra-deps {nrepl/nrepl       {:mvn/version "1.3.1"}
                cider/cider-nrepl {:mvn/version "0.55.7"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--interactive"]}

  ;; Terminal REPL with syntax highlighting, multi-line editing, inline docs
  ;; and tab-completion — the console's front door. `clj -M:rebel`
  :rebel
  {:extra-paths ["dev"]
   :extra-deps {com.bhauman/rebel-readline {:mvn/version "0.1.5"}}
   :main-opts ["-m" "rebel-readline.main"]}

  ;; One-shot dispatch: `clj -X:run :cmd :sdk/smoke :args [:scala]`
  :run
  {:exec-fn console.core/dispatch}}}
